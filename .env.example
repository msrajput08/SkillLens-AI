# Run: uvicorn app.main:app --reload --env-file .env
# Copy this file to .env and edit server-side only. Never commit API keys.

# Advanced semantic matching (optional; pip install -r requirements-ai.txt)
# Set to a local SentenceTransformer model directory OR a Hugging Face ID.
# A remote model ID may download model weights on first use.
# SKILLLENS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Experimental pre-trained-on-SYNTHETIC-DEMO-dataset custom model. Not validated
# on real-world examples. Train your own on CONSENTED, human-reviewed examples.
# SKILLLENS_CUSTOM_MODEL=models/demo_evidence.joblib

# For LOCAL LLM rewriting (you must separately install Ollama and pull the model):
# SKILLLENS_LLM_PROVIDER=ollama
# SKILLLENS_LLM_MODEL=llama3.2:3b
# SKILLLENS_OLLAMA_URL=http://127.0.0.1:11434

# Or for an external OpenAI-compatible API, requiring explicit browser consent:
# SKILLLENS_LLM_PROVIDER=openai_compatible
# SKILLLENS_LLM_MODEL=YOUR_SUPPORTED_MODEL_ID
# SKILLLENS_LLM_BASE_URL=https://api.openai.com/v1
# SKILLLENS_LLM_API_KEY=YOUR_SECRET_KEY
