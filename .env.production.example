# Customize on your VPS and save as .env.production; DO NOT commit actual values.
# Use: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
PUBLIC_DOMAIN=skilllens.example.com
POSTGRES_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_SECRET
SKILLLENS_ENV=production
SKILLLENS_CLAMAV_ADDR=clamav:3310
SKILLLENS_SITE_URL=https://skilllens.example.com
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SKILLLENS_DATA_KEY=REPLACE_WITH_VALID_FERNET_KEY
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
SMTP_FROM=support@skilllens.example.com
RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_PLAN_ID=plan_REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE
SKILLLENS_PRO_PRICE_INR=REPLACE_WITH_ACTUAL_MONTHLY_PRICE
LEGAL_OPERATOR=REPLACE_WITH_REGISTERED_OPERATOR_BUSINESS_NAME
LEGAL_POSTAL_ADDRESS=REPLACE_WITH_REAL_BUSINESS_ADDRESS
# Set to yes ONLY after legal policy pages were customized and reviewed
LEGAL_REVIEWED=no
LEGAL_CONTACT_EMAIL=support@skilllens.example.com
# Optional AI provider - see README for LLM privacy caveats
SKILLLENS_LLM_PROVIDER=
SKILLLENS_LLM_MODEL=
SKILLLENS_LLM_BASE_URL=https://api.openai.com/v1
SKILLLENS_LLM_API_KEY=
SKILLLENS_EMBED_MODEL=
SKILLLENS_CUSTOM_MODEL=
